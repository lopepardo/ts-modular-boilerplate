# App
APP_NAME=change_me
APP_ENV=development            # development|test|production
APP_VERSION=unversioned
PORT=3000
LOG_LEVEL=debug                # trace|debug|info|warn|error|fatal|silent

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=change_me
DB_PASSWORD=change_me          # required (Docker Compose also uses it)
DB_NAME=change_me
DB_SSL=false                   # true/false, 1/0, yes/no, on/off

# Pool
DB_POOL_MAX=10
DB_POOL_MIN=0
DB_POOL_IDLE_TIMEOUT_MS=30000
DB_POOL_CONNECTION_TIMEOUT_MS=2000
DB_POOL_MAX_LIFETIME_SECONDS=300
